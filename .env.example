# Application Settings
PROJECT_NAME="Multi-Paper Research Assistant"
API_V1_STR="/api/v1"
DEBUG=False
PORT=8000

# Storage Paths
UPLOAD_DIR="./storage/uploads"
CHROMA_DIR="./storage/chroma"
DATABASE_URL="sqlite:///./storage/data/research_assistant.db"

# LLM Provider Configuration
# Options: "gemini" (recommended for Render & Online deployment) or "ollama" (local)
LLM_PROVIDER="gemini"

# Google Gemini API Settings (Get your free API key at https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Ollama Settings (Local development alternative)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Embeddings & Reranker Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"

# RAG & Chunking Parameters
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5

# OCR Settings
ENABLE_OCR=True
TESSERACT_CMD=""
